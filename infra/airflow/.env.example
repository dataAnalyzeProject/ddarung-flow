# Docker 컨테이너가 생성하는 파일의 기본 사용자 ID다. Windows에서는 그대로 사용한다.
# OCI Linux VM에 배포할 때는 배포 계정의 실제 UID로 바꾼다(예: ubuntu 계정은
# 보통 1000 — 서버에서 `id -u`로 확인).
AIRFLOW_UID=50000
# scheduler/dag-processor가 api-server의 실행 API를 찾는 주소다. 컨테이너
# 내부 네트워크 기본값을 그대로 쓰면 되며 보통 바꿀 필요가 없다.
AIRFLOW_EXECUTION_API_SERVER_URL=http://airflow-api-server:8080/execution/
# 컴포넌트 간 내부 API 인증 서명 키다. 배포마다 새로 생성하고 절대 커밋하지
# 않는다. 생성: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=
# 이 저장소의 requirements를 추가해 빌드할 로컬 이미지 이름이다.
DDARUNG_AIRFLOW_IMAGE=ddarung-flow-airflow:3.3.0
# Raw 파일이 저장될 호스트 루트다. 실제 Raw 경로는 하위 platform/raw이다.
DDARUNG_DATA_ROOT=D:/ddarung-flow-data
# 정상·실패 DAG 검증에 사용할 fixture 파일명이다.
BIKE_INVENTORY_FIXTURE=bike_inventory_success.json
WEATHER_FIXTURE=weather_success.json
WEATHER_SOURCE=fixture
# 아래 두 키는 조장이 발급받은 실제 값을 .env에만 입력한다.
SEOUL_OPEN_API_KEY=
BIKE_INVENTORY_SOURCE=fixture
# 로컬 개발은 config_file(개인 OCI CLI 프로필)을 쓴다.
OCI_CONFIG_DIR=C:/Users/your-name/.oci
OCI_CONFIG_FILE=/opt/airflow/.oci/config.docker
OCI_CONFIG_PROFILE=DDARUNG_AIRFLOW
OCI_BUCKET_NAME=
OCI_AUTH_MODE=config_file
# OCI VM에 배포할 때는 instance_principal로 바꾼다 — 그 VM의 IAM 정책만으로
# 인증하므로 정적 키/config 파일이 서버에 전혀 필요 없다(backend/inference가
# 이미 staging에서 쓰는 방식과 동일, infra/inference/app.py 참고). OCI_CONFIG_*
# 값은 instance_principal 모드에서는 읽지 않는다.
RAW_STORAGE_MODE=local
KMA_SERVICE_KEY=
# 기상청 격자 좌표다. 현재 기본값은 서울 대표 개발 좌표다.
KMA_NX=60
KMA_NY=127
