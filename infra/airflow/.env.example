# Docker 컨테이너가 생성하는 파일의 기본 사용자 ID다. Windows에서는 그대로 사용한다.
AIRFLOW_UID=50000
# 이 저장소의 requirements를 추가해 빌드할 로컬 이미지 이름이다.
DDARUNG_AIRFLOW_IMAGE=ddarung-flow-airflow:3.3.0
# Raw 파일이 저장될 호스트 루트다. 실제 Raw 경로는 하위 platform/raw이다.
DDARUNG_DATA_ROOT=D:/ddarung-flow-data
# 정상·실패 DAG 검증에 사용할 fixture 파일명이다.
BIKE_INVENTORY_FIXTURE=bike_inventory_success.json
WEATHER_FIXTURE=weather_success.json
WEATHER_SOURCE=fixture
# 아래 두 키는 조장이 발급받은 실제 값을 .env에만 입력한다.
SEOUL_OPEN_API_KEY=
BIKE_INVENTORY_SOURCE=fixture
OCI_CONFIG_DIR=C:/Users/your-name/.oci
OCI_CONFIG_FILE=/opt/airflow/.oci/config.docker
OCI_CONFIG_PROFILE=DDARUNG_AIRFLOW
OCI_BUCKET_NAME=
OCI_AUTH_MODE=config_file
RAW_STORAGE_MODE=local
KMA_SERVICE_KEY=
# 기상청 격자 좌표다. 현재 기본값은 서울 대표 개발 좌표다.
KMA_NX=60
KMA_NY=127
