# Copy this file to .env.oci. Git ignores .env.* files except examples.
# Do not put an OCI auth token, private key contents, or API keys here —
# those stay only in the server's own untracked infra/airflow/.env.

# Same OCI compute instance as infra/staging (crawling_server). Airflow runs
# as a second, independent Compose project on that host — no new Compute.
AIRFLOW_HOST=
AIRFLOW_SSH_USER=ubuntu
AIRFLOW_SSH_KEY_PATH=
REMOTE_AIRFLOW_DIR=/home/ubuntu/ddarung-flow-airflow

# Airflow images are built in place on the server from the approved commit
# (no registry push/pull — DAGs are volume-mounted source, not baked into
# the image, so there is nothing meaningful to version as a registry tag).
DDARUNG_DATA_ROOT=/home/ubuntu/ddarung-flow-airflow-data

# Change to YES only after confirming in the OCI Console that this second
# Compose project stays within the same Always-Free boundary already
# approved for crawling_server + staging. Do not create or resize compute.
AIRFLOW_ZERO_COST_CONFIRMED=NO

# Airflow's web UI/API stays loopback-only (127.0.0.1) on the server, same
# as staging's PostgreSQL — no public ingress, no nginx route. Access is
# via SSH tunnel only. This script does not open any new NSG/firewall rule.
