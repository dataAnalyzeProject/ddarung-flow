# Copy this file to .env.oci. Git ignores .env.* files except examples.
# Do not put an OCI auth token, private key contents, DB password, or OAuth secret here.

OCI_REGISTRY=ap-tokyo-1.ocir.io
OCI_NAMESPACE=
OCI_REPOSITORY=ddarung-flow-staging
# Ampere A1: linux/arm64, E2.1.Micro: linux/amd64
TARGET_PLATFORM=linux/arm64

STAGING_HOST=
STAGING_SSH_USER=ubuntu
STAGING_SSH_KEY_PATH=
REMOTE_APP_DIR=/home/ubuntu/ddarung-flow-staging
STAGING_FRONTEND_PORT=3100
STAGING_PUBLIC_URL=https://shdomain.kro.kr

# Change to YES only after confirming that the existing crawling_server remains
# within the approved zero-cost boundary. Do not create or resize compute.
OCI_ZERO_COST_CONFIRMED=NO
STAGING_LIFECYCLE_MODE=CONTINUOUS_STAGING
